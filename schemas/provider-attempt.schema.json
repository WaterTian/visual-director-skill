{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/provider-attempt.schema.json",
  "title": "ProviderAttempt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "attempt_id", "asset_id", "request_sha256", "adapter", "status", "started_at", "finished_at", "timeout_seconds", "candidate", "error"],
  "properties": {
    "version": {"const": "0.1"},
    "attempt_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "model": {"type": ["string", "null"]}
      }
    },
    "status": {"enum": ["succeeded", "failed", "timed_out"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
    "candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256", "size_bytes"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "size_bytes": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "retryable": {"type": "boolean"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "candidate": {"type": "object"},
          "error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "candidate": {"type": "null"},
          "error": {"type": "object"}
        }
      }
    }
  ]
}
