{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/asset-manifest.schema.json",
  "title": "AssetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "asset_id", "status", "file", "brief_sha256", "compiled_prompt_sha256", "generation_request_sha256", "template", "source_revisions", "generation", "qc", "approvals"],
  "properties": {
    "version": {"const": "0.1"},
    "asset_id": {"type": "string", "minLength": 3},
    "status": {"enum": ["candidate", "qc_failed", "qc_passed", "approved", "landed"]},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "format", "width", "height", "has_alpha", "size_bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "format": {"enum": ["png", "jpeg", "webp"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "has_alpha": {"type": "boolean"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "brief_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compiled_prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation_request_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "score"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "score": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "source_revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "version"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "recorded_at", "record_sha256"],
      "properties": {
        "provider": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "recorded_at": {"type": "string", "format": "date-time"},
        "record_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "record_sha256", "sources"],
      "properties": {
        "method": {"enum": ["direct", "exact_canvas_composition"]},
        "record_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "source_type", "provider", "model", "role", "resampled"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "source_type": {"enum": ["generated", "reference", "project_asset"]},
              "provider": {"type": ["string", "null"], "minLength": 1},
              "model": {"type": ["string", "null"], "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "resampled": {"type": "boolean"}
            }
          }
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_status", "report_sha256"],
      "properties": {
        "overall_status": {"enum": ["pass", "fail", "review_required"]},
        "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewer", "decision", "recorded_at", "exceptions"],
        "properties": {
          "reviewer": {"type": "string", "minLength": 1},
          "decision": {"enum": ["approve", "reject"]},
          "recorded_at": {"type": "string", "format": "date-time"},
          "exceptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
