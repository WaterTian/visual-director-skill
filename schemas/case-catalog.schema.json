{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/case-catalog.schema.json",
  "title": "CaseCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "taxonomy", "summary", "cases"],
  "properties": {
    "version": {"const": "0.1"},
    "source": {"$ref": "#/$defs/source"},
    "taxonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "styles", "scenes"],
      "properties": {"categories": {"$ref": "#/$defs/stringList"}, "styles": {"$ref": "#/$defs/stringList"}, "scenes": {"$ref": "#/$defs/stringList"}}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_count", "approved_count"],
      "properties": {"record_count": {"type": "integer", "minimum": 1}, "approved_count": {"type": "integer", "minimum": 1}}
    },
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/caseRecord"}}
  },
  "$defs": {
    "stringList": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "license", "catalog_path"],
      "properties": {
        "kind": {"const": "first-party"},
        "version": {"type": "string", "minLength": 1},
        "license": {"const": "MIT"},
        "catalog_path": {"const": "data/cases.json"}
      }
    },
    "caseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "styles", "scenes", "featured", "selection_text", "prompt_path", "prompt_sha256", "image", "status"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "styles": {"$ref": "#/$defs/stringList"},
        "scenes": {"$ref": "#/$defs/stringList"},
        "featured": {"type": "boolean"},
        "selection_text": {"type": "string", "minLength": 80},
        "prompt_path": {"type": "string", "pattern": "^gallery/prompts/[^/]+\\.md$"},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "alt"],
          "properties": {"path": {"type": "string", "pattern": "^gallery/images/[^/]+\\.png$"}, "alt": {"type": "string", "minLength": 1}}
        },
        "status": {"const": "approved_public_gallery"}
      }
    }
  }
}
