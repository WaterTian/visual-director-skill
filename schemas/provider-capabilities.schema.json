{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/provider-capabilities.schema.json",
  "title": "ProviderCapabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "provider", "model", "operations", "output", "input_images", "evidence"],
  "properties": {
    "version": {"const": "0.1"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": ["string", "null"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["create", "edit"]},
      "uniqueItems": true
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formats", "transparency", "dimension_policy", "supported_sizes", "dimension_constraints"],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["png", "jpeg", "webp"]},
          "uniqueItems": true
        },
        "transparency": {"type": "boolean"},
        "dimension_policy": {"enum": ["exact", "constrained_exact", "fixed_presets", "aspect_only", "unverified"]},
        "supported_sizes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height"],
            "properties": {
              "width": {"type": "integer", "minimum": 64},
              "height": {"type": "integer", "minimum": 64}
            }
          }
        },
        "dimension_constraints": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["edge_multiple", "maximum_edge", "maximum_ratio", "minimum_pixels", "maximum_pixels"],
              "properties": {
                "edge_multiple": {"type": "integer", "minimum": 1},
                "maximum_edge": {"type": "integer", "minimum": 64},
                "maximum_ratio": {"type": "number", "minimum": 1},
                "minimum_pixels": {"type": "integer", "minimum": 4096},
                "maximum_pixels": {"type": "integer", "minimum": 4096}
              }
            }
          ]
        }
      }
    },
    "input_images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "maximum"],
      "properties": {
        "supported": {"type": "boolean"},
        "maximum": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"output": {"properties": {"dimension_policy": {"const": "fixed_presets"}}}}},
      "then": {"properties": {"output": {"properties": {"supported_sizes": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"output": {"properties": {"dimension_policy": {"const": "constrained_exact"}}}}},
      "then": {"properties": {"output": {"properties": {"dimension_constraints": {"type": "object"}}}}},
      "else": {"properties": {"output": {"properties": {"dimension_constraints": {"type": "null"}}}}}
    }
  ]
}
