{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/compiled-prompt.schema.json",
  "title": "CompiledPrompt",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "asset_id", "template", "prompt", "prompt_sha256", "case_selection_sha256", "case_references", "hard_constraints", "assumptions", "conflicts", "sources"],
  "properties": {
    "version": {"const": "0.1"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "score", "score_breakdown"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "score_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "style", "scene", "constraint"],
          "properties": {
            "category": {"type": "integer", "minimum": 0, "maximum": 55},
            "style": {"type": "integer", "minimum": 0, "maximum": 20},
            "scene": {"type": "integer", "minimum": 0, "maximum": 10},
            "constraint": {"type": "integer", "minimum": 0, "maximum": 15}
          }
        }
      }
    },
    "prompt": {"type": "string", "minLength": 40},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "case_selection_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "case_references": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/caseReference"}
    },
    "hard_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "format", "transparent_background", "exact_text", "must_include", "must_avoid"],
      "properties": {
        "width": {"type": "integer", "minimum": 64},
        "height": {"type": "integer", "minimum": 64},
        "format": {"enum": ["png", "jpeg", "webp"]},
        "transparent_background": {"type": "boolean"},
        "exact_text": {"type": "array", "items": {"type": "string"}},
        "must_include": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "must_avoid": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"transparent_background": {"const": true}}},
          "then": {"properties": {"format": {"enum": ["png", "webp"]}}}
        }
      ]
    },
    "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "version"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "caseReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "score", "prompt_sha256", "image_path", "image_sha256", "structure_cues"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "score": {"type": "integer", "minimum": 0, "maximum": 100},
        "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "image_path": {"type": "string", "pattern": "^gallery/images/[^/]+\\.png$"},
        "image_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "structure_cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"type": "string", "pattern": "^[a-z]+:[a-z0-9-]+$"},
          "uniqueItems": true
        }
      }
    }
  }
}
