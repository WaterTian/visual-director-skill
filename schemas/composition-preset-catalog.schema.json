{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/composition-preset-catalog.schema.json",
  "title": "CompositionPresetCatalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "presets"],
  "properties": {
    "version": {"const": "0.1"},
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "deliverable_types", "aspect_ratio", "exact_text", "canvas", "raster_box", "text_slots"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "description": {"type": "string", "minLength": 10},
          "deliverable_types": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "aspect_ratio": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum", "maximum"],
            "properties": {
              "minimum": {"type": "number", "exclusiveMinimum": 0},
              "maximum": {"type": "number", "exclusiveMinimum": 0}
            }
          },
          "exact_text": {
            "type": "object",
            "additionalProperties": false,
            "required": ["minimum", "maximum"],
            "properties": {
              "minimum": {"type": "integer", "minimum": 0},
              "maximum": {"type": "integer", "minimum": 1}
            }
          },
          "canvas": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "background", "transparent_background"],
            "properties": {
              "format": {"const": "png"},
              "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
              "transparent_background": {"type": "boolean"}
            }
          },
          "raster_box": {"$ref": "#/$defs/ratio_box"},
          "text_slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y", "font_size", "minimum_font_size", "maximum_font_size", "max_width", "fill", "anchor"],
              "properties": {
                "x": {"type": "number", "minimum": 0, "maximum": 1},
                "y": {"type": "number", "minimum": 0, "maximum": 1},
                "font_size": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "minimum_font_size": {"type": "integer", "minimum": 8},
                "maximum_font_size": {"type": "integer", "minimum": 8, "maximum": 512},
                "max_width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                "fill": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                "anchor": {"enum": ["lt", "lm", "lb", "mt", "mm", "mb", "rt", "rm", "rb"]}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "ratio_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    }
  }
}
