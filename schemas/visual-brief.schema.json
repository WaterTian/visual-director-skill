{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/visual-brief.schema.json",
  "title": "VisualBrief",
  "description": "Portable v0.1 input contract for a single visual asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "asset_id",
    "goal",
    "deliverable",
    "content",
    "art_direction",
    "composition",
    "qa"
  ],
  "properties": {
    "version": {
      "const": "0.1"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "goal": {
      "type": "string",
      "minLength": 8
    },
    "audience": {
      "type": "string"
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "width", "height", "format"],
      "properties": {
        "type": {
          "enum": ["product", "hero", "poster", "infographic", "ui", "brand", "illustration", "character", "scene", "edit", "other"]
        },
        "width": {
          "type": "integer",
          "minimum": 64
        },
        "height": {
          "type": "integer",
          "minimum": 64
        },
        "format": {
          "enum": ["png", "jpeg", "webp"]
        },
        "transparent_background": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"transparent_background": {"const": true}},
            "required": ["transparent_background"]
          },
          "then": {"properties": {"format": {"enum": ["png", "webp"]}}}
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "must_include", "must_avoid"],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 3
        },
        "exact_text": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "must_include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "must_avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "art_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "palette", "lighting", "materials"],
      "properties": {
        "style": {
          "type": "string",
          "minLength": 3
        },
        "palette": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lighting": {
          "type": "string",
          "minLength": 3
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout", "viewpoint", "focal_hierarchy"],
      "properties": {
        "layout": {
          "type": "string",
          "minLength": 3
        },
        "viewpoint": {
          "type": "string",
          "minLength": 3
        },
        "focal_hierarchy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["uri", "role"],
        "properties": {
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": ["identity", "composition", "style", "palette", "material"]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_checks", "visual_checks", "approval_required"],
      "properties": {
        "objective_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visual_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "approval_required": {
          "type": "boolean"
        }
      }
    }
  }
}
