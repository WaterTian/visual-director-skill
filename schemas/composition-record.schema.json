{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/visual-director/composition-record.schema.json",
  "title": "CompositionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "asset_id", "plan_sha256", "raster_transforms", "text_layers", "output"],
  "properties": {
    "version": {"const": "0.1"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raster_transforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_path", "source_sha256", "source_type", "provider", "model", "role", "trim_transparent", "fit", "original_size", "source_crop", "rendered_size", "position", "resampled"],
        "properties": {
          "source_path": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_type": {"enum": ["generated", "reference", "project_asset"]},
          "provider": {"type": ["string", "null"], "minLength": 1},
          "model": {"type": ["string", "null"], "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "trim_transparent": {"type": "boolean"},
          "fit": {"enum": ["native", "contain"]},
          "original_size": {"$ref": "#/$defs/size"},
          "source_crop": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/box"}
            ]
          },
          "rendered_size": {"$ref": "#/$defs/size"},
          "position": {"$ref": "#/$defs/position"},
          "resampled": {"type": "boolean"}
        }
      }
    },
    "text_layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "position", "font_size", "fill", "anchor", "font", "font_sha256"],
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "position": {"$ref": "#/$defs/position"},
          "font_size": {"type": "integer", "minimum": 8},
          "max_width": {"type": ["integer", "null"], "minimum": 1},
          "fill": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "anchor": {"type": "string", "minLength": 2},
          "font": {"type": "string", "minLength": 1},
          "rendered_bbox": {"$ref": "#/$defs/box"},
          "font_sha256": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            ]
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "format", "width", "height", "has_alpha", "size_bytes"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "format": {"const": "png"},
        "width": {"type": "integer", "minimum": 64},
        "height": {"type": "integer", "minimum": 64},
        "has_alpha": {"type": "boolean"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0}
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  }
}
